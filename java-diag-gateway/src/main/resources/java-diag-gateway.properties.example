# =============================================================================
# java-diag Gateway — 全量配置模板
# 复制为 ./java-diag-gateway.properties，或：java -jar ... --config /path/to/file
# 未指定 --config 时还会加载 classpath /java-diag-gateway.properties，以及向上最多 6 层的
# java-diag-gateway.properties.local（更近优先）。显式 --config 替换整个文件层。
# 优先级：内置默认值 → 文件层 → 环境变量 JAVA_DIAG_* → CLI（最高）
# 完整说明：docs/CONFIGURATION.md（参数表以本文件为准）
# Gateway 仅 HTTP，无 transport 配置项
# =============================================================================

# --- HTTP ---
# 监听地址
http.host=0.0.0.0
# 监听端口
http.port=8787

# --- 鉴权 Auth ---
# Agent / MCP（/sse、/mcp）Bearer（必填，不可为空）
auth.token=CHANGE_ME_AGENT_TOKEN
# /registry/* 注册与心跳 API Bearer（必填）；探针侧须配置相同值
register.token=CHANGE_ME_REGISTER_TOKEN

# --- 注册表 / 心跳 ---
# 探针心跳 TTL（秒）：超时未心跳则下线；有效值 ≥5
heartbeat.ttl.seconds=90
# Gateway 自身 MCP envelope 的 instanceId；空=运行时 gateway-{pid}
instance.id=

# --- 审计 ---
# 代理侧审计 JSONL 路径
audit.path=./logs/java-diag-gateway-audit.log

# --- 限流（代理侧昂贵工具冷却）---
# 与探针 dump.cooldown.ms 语义相同，在网关对下游探针做冷却
dump.cooldown.ms=10000

# --- Admin 控制台（/admin/）---
# 控制台登录用户名
admin.user=admin
# 控制台登录密码（占位值；共享/生产环境务必改为强密码；启动时若仍为默认或 CHANGE_ME* 会打 WARNING）
admin.password=CHANGE_ME_ADMIN_PASSWORD

# Legacy env 键亦可在本文件中书写，例如 JAVA_DIAG_AUTH_TOKEN=secret
